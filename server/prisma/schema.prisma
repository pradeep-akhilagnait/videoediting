// =============================================================================
// Prisma schema — Varna UPVC
// =============================================================================
//
// The production schema lives in the existing MySQL database `varna_upvc_app`.
// This file is meant to be REGENERATED from that database:
//
//     npx prisma db pull      # introspect -> overwrite the models below
//     npx prisma generate
//
// Until the live DB is reachable, the models below are a small PROVISIONAL set
// covering only authentication, RBAC and the audit log, so the API compiles and
// runs. `prisma db pull` replaces everything after the generator/datasource
// blocks with the real tables.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PROVISIONAL MODELS (replaced by `prisma db pull`)
// ---------------------------------------------------------------------------

/// Application users. No public sign-up (FR-1.1); created by setup or a Manager.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  passwordResets    PasswordReset[]
  permissionGrants  UserPermissionGrant[]
  auditLogs         AuditLog[]

  @@map("users")
}

/// Role: MANAGER (everything) or STAFF (FR-1.6).
model Role {
  id          String           @id @default(cuid())
  name        String           @unique // "MANAGER" | "STAFF"
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single permission code checked on protected actions (FR-1.7, default deny).
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "quotation.create"
  description String?

  roles  RolePermission[]
  grants UserPermissionGrant[]

  @@map("permissions")
}

/// Which permissions a role has by default.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Per-user permission override so a Manager can adjust Staff permissions (FR-1.6).
/// `granted = false` revokes a permission the role would otherwise have.
model UserPermissionGrant {
  userId       String
  permissionId String
  granted      Boolean
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_grants")
}

/// A refresh-token session. Tokens rotate on use; reuse of a retired token
/// revokes the whole family and logs the user out everywhere (FR-1.3).
model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String // shared by every token in one login's rotation chain
  tokenHash    String    @unique // sha-256 of the refresh token; raw token never stored
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // the session that rotated this one out
  userAgent    String?   @db.Text
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Password reset request (FR-1.4). Only the hash of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

/// Append-only audit log: who did what, when, and the before/after state (FR-1.10).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "create" | "update" | "delete" | custom
  entityType String // e.g. "Quotation"
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
