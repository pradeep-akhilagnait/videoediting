// =============================================================================
// Prisma schema — Varna UPVC  (maps to the existing MySQL database upvc_app)
// =============================================================================
//
// This schema is written BY HAND to match the team's launch schema
// (upvc_launch_schema_mysql8.sql). Prisma does not own the database: it never
// migrates it. Models here mirror real tables; column names are mapped with
// @map and table names with @@map.
//
// It currently models the AUTH / TENANCY subset needed to sign in. Remaining
// tables (customers, projects, designs, quotations, …) are added model-by-model
// as each feature section is built. Unmodeled tables are simply ignored by
// Prisma and left untouched in the database.
//
// Conventions from the SQL, reflected here:
//   * id        BIGINT UNSIGNED, internal only  -> BigInt @db.UnsignedBigInt
//   * public_id CHAR(36) UUID, used in URLs      -> exposed instead of id
//   * company_id multi-tenant key on every business table
//   * Generated columns (is_live, area_sqft, …) are OMITTED: the DB fills them
//     and the app must never write them.
//   * created_by / updated_by / deleted_by are kept as plain scalar columns
//     (no Prisma relation) to avoid a tangle of self-relations to users.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// GST state codes (e.g. '36' = Telangana).
model IndianState {
  code String @id @db.Char(2)
  name String @db.VarChar(60)

  @@map("indian_states")
}

/// A fabricator business (tenant). The first company + Owner are created by the
/// seed; the app takes company_id from the session, never from the request.
model Company {
  id             BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String  @unique(map: "uq_companies_public") @default(uuid()) @map("public_id") @db.Char(36)
  name           String  @db.VarChar(150)
  tagline        String? @db.VarChar(200)
  addressLine    String? @map("address_line") @db.Text
  city           String? @db.VarChar(100)
  stateCode      String  @map("state_code") @db.Char(2)
  pincode        String? @db.Char(6)
  email          String? @db.VarChar(150)
  phone          String? @db.VarChar(15)
  gstin          String? @db.Char(15)
  logoUrl        String? @map("logo_url") @db.VarChar(500)
  website        String? @db.VarChar(200)
  quotationTerms String? @map("quotation_terms") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  users User[]
  roles Role[]

  @@map("companies")
}

/// A role is company-scoped. company_id NULL = seed template (copied per
/// company on sign-up). A Manager adjusts staff permissions by editing the
/// role's permissions (FR-1.6).
model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId   BigInt?  @map("company_id") @db.UnsignedBigInt
  name        String   @db.VarChar(60)
  description String?  @db.VarChar(200)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime? @map("deleted_at") @db.DateTime(3)

  company     Company?         @relation(fields: [companyId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, id], map: "uq_roles_tenant")
  @@map("roles")
}

/// Fixed catalogue of permission codes (maintained via the seed/migrations).
model Permission {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  code        String  @unique(map: "uq_permissions_code") @db.VarChar(80)
  module      String  @db.VarChar(40)
  description String? @db.VarChar(200)

  roles RolePermission[]

  @@map("permissions")
}

/// Which permissions a role grants.
model RolePermission {
  roleId       BigInt   @map("role_id") @db.UnsignedBigInt
  permissionId BigInt   @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permissions_perm")
  @@map("role_permissions")
}

/// Application user. No public sign-up; created by the seed or a Manager.
/// email is unique among live rows in the DB (email, is_live).
model User {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String    @unique(map: "uq_users_public") @default(uuid()) @map("public_id") @db.Char(36)
  companyId    BigInt    @map("company_id") @db.UnsignedBigInt
  name         String    @db.VarChar(120)
  email        String    @db.VarChar(150)
  mobile       String?   @db.VarChar(15)
  userType     String    @default("fabricator") @map("user_type")
  roleId       BigInt?   @map("role_id") @db.UnsignedBigInt
  supplierId   BigInt?   @map("supplier_id") @db.UnsignedBigInt
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    BigInt?   @map("created_by") @db.UnsignedBigInt
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)
  deletedBy    BigInt?   @map("deleted_by") @db.UnsignedBigInt

  company  Company       @relation(fields: [companyId], references: [id])
  role     Role?         @relation(fields: [roleId], references: [id])
  sessions UserSession[]

  @@index([companyId], map: "ix_users_company")
  @@map("users")
}

/// A refresh-token session. Only the SHA-256 hash of the token is stored.
/// Tokens rotate on use; reuse of a revoked token revokes the user's sessions.
model UserSession {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  publicId   String    @unique(map: "uq_sessions_public") @default(uuid()) @map("public_id") @db.Char(36)
  companyId  BigInt    @map("company_id") @db.UnsignedBigInt
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash  String    @unique(map: "uq_sessions_token_hash") @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, userId, expiresAt], map: "ix_sessions_user_expiry")
  @@map("user_sessions")
}

/// Append-only audit log (one row per insert/update/delete of business data).
model AuditLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  companyId BigInt?  @map("company_id") @db.UnsignedBigInt
  tableName String   @map("table_name") @db.VarChar(64)
  recordId  BigInt?  @map("record_id") @db.UnsignedBigInt
  action    String // 'insert' | 'update' | 'delete' | 'restore'
  changedBy BigInt?  @map("changed_by") @db.UnsignedBigInt
  changedAt DateTime @default(now()) @map("changed_at") @db.DateTime(3)
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")

  @@index([tableName, recordId, changedAt], map: "ix_audit_record")
  @@index([companyId, changedAt], map: "ix_audit_company")
  @@map("audit_log")
}
