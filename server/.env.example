# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# MySQL connection string for the existing varna_upvc_app database.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/varna_upvc_app"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS="http://localhost:5173"

# --- Auth -----------------------------------------------------------------
# Use long random strings. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Access token lifetime (short) and refresh token lifetime (long).
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
